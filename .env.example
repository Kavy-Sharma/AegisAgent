# AegisAgent MQTT Broker Credentials Example
AEGIS_MQTT_USER=aegis_gateway
AEGIS_MQTT_PASS=<CHOOSE-A-STRONG-PASSWORD>

# Dashboard & Worker IPC Signing Secret (HMAC-SHA256, auto-generated if missing)
AEGIS_DASH_SECRET=<64-HEX-CHARACTER-SECRET>

# Default city for live weather queries when no location is given
AEGIS_DEFAULT_CITY=Jodhpur

# Live Open-Meteo weather lookups ("1" enabled, "0" refuses offline)
AEGIS_WEATHER_ONLINE=1
